{
  "name": "drillr-market-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A dense, real-data market dashboard powered by the Drillr financial data gateway.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huluwa2026/drillr-market-dashboard.git"
  },
  "keywords": [
    "drillr",
    "financial-data",
    "market-dashboard",
    "stocks",
    "vercel"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "capture:og": "node scripts/capture-og.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "type": "module"
}
