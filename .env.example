# Required: create a Drillr Gateway API key at your Drillr account.
DRILLR_API_KEY=

# Optional: override the default Drillr Gateway endpoint.
DRILLR_GATEWAY_URL=https://gateway.drillr.ai

# Required in production: provision Upstash Redis from the Vercel Marketplace.
# Local development uses an in-memory store when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Compatible aliases used by some Vercel Marketplace integrations.
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_KEY_PREFIX=drillr-market-dashboard:v1

# Public API safety. Defaults are shown; use a unique random salt in production.
PUBLIC_API_RATE_LIMIT_PER_MINUTE=20
PUBLIC_API_DASHBOARD_RATE_LIMIT_PER_MINUTE=3
PUBLIC_API_LIVE_RATE_LIMIT_PER_MINUTE=6
PUBLIC_API_SIGNALS_RATE_LIMIT_PER_MINUTE=4
PUBLIC_API_INTRADAY_RATE_LIMIT_PER_MINUTE=10
PUBLIC_API_STOCKS_RATE_LIMIT_PER_MINUTE=6
DRILLR_DAILY_REQUEST_LIMIT=5000
DRILLR_DAILY_DASHBOARD_LIMIT=500
DRILLR_DAILY_LIVE_LIMIT=3000
DRILLR_DAILY_SIGNALS_LIMIT=1000
DRILLR_DAILY_INTRADAY_LIMIT=2000
DRILLR_CIRCUIT_FAILURE_THRESHOLD=5
DRILLR_CIRCUIT_COOLDOWN_SECONDS=60
RATE_LIMIT_SALT=

# Production admin identity. "disabled" is the secure default.
# Use "openai-sites" only behind that trusted platform boundary, or "hmac"
# when a trusted proxy signs the documented identity headers.
TRUSTED_IDENTITY_MODE=disabled
TRUSTED_IDENTITY_HMAC_SECRET=

# Required for production stock management: comma-separated admin emails.
ADMIN_EMAILS=

# Development only. Production builds ignore this switch.
ALLOW_LOCAL_ADMIN=true
